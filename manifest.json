{
  "manifest_version": 3,
  "name": "TikTok Repost Remover",
  "version": "1.0",
  "description": "أداة لحذف ريبوستات تيك توك",
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://tiktok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
